# --- Bunny Loader ---
# Dumps do jogo: gerados localmente, NUNCA versionados.
refs/*
!refs/README.md

# QuickJS vendored sources (baixados localmente, ver third_party/README.md)
app/src/main/cpp/third_party/quickjs/

# APK modificado do jogo (copia alterada de jogo pago) e chaves — NUNCA versionar
/out/
*.keystore

# artefatos temporarios do dev-cycle
/.devcycle/

# dir de trabalho do dex do CheatBridge (o header gerado E versionado)
.cheatbridge/

# Binários e assets do jogo — integração local, não versionada
app/src/main/jniLibs/arm64-v8a/*.so
terraria1456_assets/src/main/assets/
licensing-classes/

# Cache do Python das ferramentas
__pycache__/

# Texturas de origem: arte do Terraria, nao vai para o repositorio.
# So o README, que explica a convencao de nomes.
_icons/*
!_icons/README.md
