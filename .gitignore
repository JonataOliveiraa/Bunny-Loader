# --- Android / Gradle ---
*.iml
.gradle/
local.properties
# Tokens do GitHub: o que o APK do catálogo (catalog/) embute e o de publicar
# mods no Bunny-Loader-Mods (publish.py, migrate_releases.py). Nunca no Git.
_token.txt
bunnyloadermodstoken.txt
# Webhook privado usado pelo gerenciador para avisos no Discord.
bunnyloaderdiscordwebhook.txt
.idea/
.DS_Store
build/
/captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.keystore
!debug.keystore
# Chave e senhas do APK de release (ver keystore.properties.example).
*.jks
keystore.properties

# --- Bunny Loader ---
# Dumps do jogo: gerados localmente, NUNCA versionados.
refs/*
!refs/README.md

# QuickJS vendored sources (baixados localmente, ver third_party/README.md)
app/src/main/cpp/third_party/quickjs/

# APK modificado do jogo (copia alterada de jogo pago) e chaves — NUNCA versionar
/out/
*.keystore

# artefatos temporarios do dev-cycle
/.devcycle/

# dir de trabalho do dex do CheatBridge (o header gerado E versionado)
.cheatbridge/

# Binários e assets do jogo — integração local, não versionada
app/src/main/jniLibs/arm64-v8a/*.so
terraria1456_assets/src/main/assets/
licensing-classes/

# Cache do Python das ferramentas
__pycache__/

# Texturas de origem: arte do Terraria, nao vai para o repositorio.
# So o README, que explica a convencao de nomes.
_icons/*
!_icons/README.md

# Saida de build: APKs de 180+ MB, nada disso vai para o repositorio.
out/

# Sprites do jogo por ID: arte do Terraria, nao vai para o repositorio.
# So o README, que explica a convencao.
_sprites/*
!_sprites/README.md

# Log de erro do compilador Kotlin, gerado no build.
.kotlin/

# Caches do tools/disasm: saem do refs/ (dump do jogo) pelo prep.sh.
tools/disasm/*.pkl
tools/disasm/fstarts.txt
tools/disasm/dynsym.txt

# Codigo do tModLoader/ExampleMod usado so como referencia local.
exmod_tmod/
exmod_tl/

# Audio de teste do usuario, de origem desconhecida: fica fora do repositorio publico.
/sounds/

# Pacote temporario de mod do tools/bench/run.sh (um por rodada).
/blmod.*.tar

# Os ports de textura moram no repositorio de mods (Bunny-Loader-Mods); o
# clone que o publish.py mantem fica em build/mods-repo.
/ports/

# Componentes de terceiros que o build usa, mas que nao sao nossos para publicar:
# as classes Java da Unity (procedencia em app/libs/README.md) e a fonte Andy
# Bold, da Monotype (sem ela o build usa app/src/fontFallback).
app/libs/unity-classes.jar
app/src/main/res/font/bunny.ttf

# Saida do SDK do .NET (a API C# e os mods C# de teste)
app/src/main/csharp/**/bin/
app/src/main/csharp/**/obj/
tools/tests/*/src/bin/
tools/tests/*/src/obj/
tools/tests/*/content/*.dll

# Saída do compilador dos mods com fontes (bin/MeuMod.dll + selo)
tools/tests/*/content/bin/
tools/mods/csbuild/bin/
tools/mods/csbuild/obj/
