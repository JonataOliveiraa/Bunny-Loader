HitModifiersShowcase:
{
    DisplayName: 命中修饰展示
    Tooltip: ""
    Switching: 切换到模式 #{0}：{1}
    CurrentMode: 模式 #{0}：{1}
    Mode_0: 普通伤害
    Mode_1: 已关闭伤害浮动
    Mode_2: "额外 {0}% 击退"
    Mode_3: "额外 {0}% 暴击伤害"
    Mode_4: "额外 {0} 点盔甲穿透。请对高防御敌人测试"
    Mode_5: "额外 {0}% 盔甲穿透。无视敌人 {0}% 的防御"
    Mode_6: 施加 ExampleDefenseDebuff，使防御降低 {0}%
    Mode_7: 命中时给予玩家 ExampleDodgeBuff，以闪避下一次攻击
}
