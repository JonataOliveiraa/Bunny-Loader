Commands: {
	ExampleCoinsCommand: {
		Description: Показать окно монет в минуту
	}

	ExampleItemCommand: {
		Usage:
			'''
			/item <тип|название> [количество]
			тип — ItemID предмета.
			название — название предмета на текущем языке.
			Пробелы в названии замените подчёркиваниями.
			'''
		Description: Создаёт предмет по названию или по ID типа
		Error_0: Нужен хотя бы один аргумент.
		Error_1: Неизвестный предмет — укажите верное название или 0 < тип < {0}
		Error_2: Количество должно быть целым числом, а получено: {0}
	}

	ExampleTimeCommand: {
		Usage:
			'''
			/addTime numTicks
			numTicks — положительное или отрицательное число тиков (1 секунда = 60 тиков).
			'''
		Description: Добавляет numTicks, чтобы перемотать время мира вперёд или назад
		Error_0: Нужен хотя бы один аргумент.
		Error_1: "{0} — неверное целое значение."
	}

	ModifyServerConfigValueCommand: {
		Usage:
			'''
			/setSomeNumber value
			value — число, которое присваивается ModConfigShowcaseAcceptClientChanges.SomeNumber
			'''
		Description: Задаёт ModConfigShowcaseAcceptClientChanges.SomeNumber. Показывает команду, которая меняет значение ModConfig и сохраняет эту конфигурацию.
		Error_0: Нужен хотя бы один аргумент.
		Error_1: "{0} — неверное целое значение."
	}
}

