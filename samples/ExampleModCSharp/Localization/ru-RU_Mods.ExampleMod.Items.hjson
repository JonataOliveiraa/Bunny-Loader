HitModifiersShowcase:
{
    DisplayName: Витрина модификаторов удара
    Tooltip: ""
    Switching: Переключение на режим №{0}: {1}
    CurrentMode: Режим №{0}: {1}
    Mode_0: Обычный урон
    Mode_1: Разброс урона отключён
    Mode_2: "+{0}% к отбрасыванию"
    Mode_3: "+{0}% к критическому урону"
    Mode_4: "+{0} к пробиванию брони. Проверьте на враге с высокой защитой"
    Mode_5: "+{0}% к пробиванию брони. Игнорирует {0}% защиты врага"
    Mode_6: Накладывает ExampleDefenseDebuff, снижая защиту на {0}%
    Mode_7: При попадании даёт игроку ExampleDodgeBuff, чтобы уклониться от следующего удара
}
