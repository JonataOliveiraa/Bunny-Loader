ExampleBugNet:
{
    DisplayName: Пример сачка
    Tooltip:
        '''
        Используется для ловли зверушек
        С вероятностью {0}% ловит лавовых зверушек
        С активным эффектом зелья тепла вероятность растёт до {1}%
        С вероятностью {2}% удваивает пойманных зверушек
        '''
}
