ExampleSpecificAmmoGun:
{
    DisplayName: Rifle de exemplo
    Tooltip:
        '''
        Não aceita balas amaldiçoadas como munição
        Dispara três tiros em rápida sucessão
        Cada tiro tem uma chance diferente de consumir munição
        O primeiro tiro tem {0}% de chance de não consumir balas
        O segundo tiro tem {1}% de chance de não consumir balas
        O último tiro tem {2}% de chance de não consumir balas
        Tiros que consomem munição causam {3}% a mais de dano
        '''
}
