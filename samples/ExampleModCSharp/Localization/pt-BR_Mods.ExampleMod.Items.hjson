HitModifiersShowcase:
{
    DisplayName: Demonstração de modificadores de acerto
    Tooltip: ""
    Switching: Alternando para o modo nº {0}: {1}
    CurrentMode: Modo nº {0}: {1}
    Mode_0: Comportamento normal de dano
    Mode_1: Variação de dano desativada
    Mode_2: "{0}% de repulsão adicional"
    Mode_3: "{0}% de dano crítico adicional"
    Mode_4: "{0} de penetração de armadura adicional. Teste contra inimigos com defesa alta"
    Mode_5: "{0}% de penetração de armadura adicional. Ignora {0}% da defesa do inimigo"
    Mode_6: Aplica ExampleDefenseDebuff, reduzindo a defesa em {0}%
    Mode_7: Ao acertar, concede ExampleDodgeBuff para esquivar do próximo golpe
}
