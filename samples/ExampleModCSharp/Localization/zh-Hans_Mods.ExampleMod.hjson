Commands: {
	ExampleCoinsCommand: {
		Description: 显示每分钟钱币界面
	}

	ExampleItemCommand: {
		Usage:
			'''
			/item <类型|名称> [数量]
			类型 — 物品的 ItemID。
			名称 — 当前语言下的物品名称。
			物品名称中的空格请用下划线代替。
			'''
		Description: 按名称或类型 ID 生成物品
		Error_0: 至少需要一个参数。
		Error_1: 未知物品 — 必须是有效名称，或 0 < 类型 < {0}
		Error_2: 数量必须是整数，但收到的是：{0}
	}

	ExampleTimeCommand: {
		Usage:
			'''
			/addTime numTicks
			numTicks — 正数或负数的刻数（1 秒 = 60 刻）。
			'''
		Description: 增加 numTicks，让世界时间快进或倒退
		Error_0: 至少需要一个参数。
		Error_1: "{0} 不是有效的整数值。"
	}

	ModifyServerConfigValueCommand: {
		Usage:
			'''
			/setSomeNumber value
			value — 要赋给 ModConfigShowcaseAcceptClientChanges.SomeNumber 的数字
			'''
		Description: 设置 ModConfigShowcaseAcceptClientChanges.SomeNumber。展示命令如何修改 ModConfig 的值并保存配置。
		Error_0: 至少需要一个参数。
		Error_1: "{0} 不是有效的整数值。"
	}
}

