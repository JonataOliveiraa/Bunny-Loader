<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Gera as proxies C# do jogo (Terraria.Item, Microsoft.Xna.Framework.Vector2...)
    e os hooks On_<Tipo> a partir dos DummyDll do Il2CppDumper (refs/DummyDll).
    Roda no build do BunnyLoader.csproj; o resultado nao vai para o Git.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>ProxyGen</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="9.0.0" />
  </ItemGroup>

</Project>
