<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Precisamos consultar o pacote do Terraria instalado. -->
    <queries>
        <package android:name="com.and.games505.TerrariaPaid" />
        <!-- Variante gratuita, se for dar suporte:
        <package android:name="com.and.games505.TerrariaFree" /> -->
    </queries>

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:extractNativeLibs="true"
        android:largeHeap="true"
        android:theme="@style/Theme.BunnyLoader">

        <activity
            android:name=".LauncherActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Roda em processo separado: fechar o jogo destrói Unity+IL2CPP+VM
             sem derrubar a UI do launcher, e cada partida começa limpa. -->
        <activity
            android:name=".GameActivity"
            android:exported="false"
            android:process=":game"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation|uiMode|screenLayout|density"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen" />
    </application>
</manifest>
