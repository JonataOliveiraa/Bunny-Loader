<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Consultamos o Terraria original e o modificado (coexistente) — no
         Android 11+ e preciso declarar visibilidade de pacotes. -->
    <queries>
        <package android:name="com.and.games505.TerrariaPaid" />
        <package android:name="com.bunnyloader.terraria.paid" />
    </queries>

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@drawable/ic_bunny"
        android:roundIcon="@drawable/ic_bunny"
        android:theme="@style/Theme.BunnyLoader">

        <activity
            android:name=".LauncherActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
