<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- O jogo hospedado roda com AS NOSSAS permissões, não com as dele. Estas
         são as que o Terraria declara; sem elas o license check do PairIP e a
         rede do jogo falham. Ver `aapt dump badging` do APK do jogo. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="com.android.vending.CHECK_LICENSE" />

    <!-- O gate de elegibilidade consulta o Terraria instalado — no Android 11+
         é preciso declarar visibilidade de pacotes. -->
    <queries>
        <package android:name="com.and.games505.TerrariaPaid" />
    </queries>

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:largeHeap="true"
        android:theme="@style/Theme.BunnyLoader">

        <!-- A Unity lê estes meta-data do pacote HOSPEDEIRO (o nosso) via
             PackageManager, então precisam existir aqui. Copiados do manifest
             do Terraria. Ver docs/UNITY-HOSTING.md §5. -->
        <meta-data android:name="unity.splash-mode" android:value="1" />
        <meta-data android:name="unity.splash-enable" android:value="true" />
        <meta-data android:name="unity.launch-fullscreen" android:value="true" />
        <meta-data android:name="unity.auto-report-fully-drawn" android:value="true" />
        <meta-data android:name="notch.config" android:value="portrait|landscape" />

        <activity
            android:name=".LauncherActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hospeda o Terraria no NOSSO processo. Config espelhada da
             com.unity3d.player.UnityPlayerActivity do jogo. Processo separado:
             fechar o jogo derruba Unity+IL2CPP sem matar a UI do launcher. -->
        <activity
            android:name=".GameActivity"
            android:exported="false"
            android:process=":game"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:hardwareAccelerated="false"
            android:resizeableActivity="false"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|fontScale|layoutDirection|density"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
            <meta-data android:name="unityplayer.UnityActivity" android:value="true" />
            <meta-data android:name="android.notch_support" android:value="true" />
        </activity>
    </application>
</manifest>
