<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Precisamos consultar o pacote do Terraria instalado. -->
    <queries>
        <package android:name="com.and.games505.TerrariaPaid" />
        <!-- Variante gratuita, se for dar suporte:
        <package android:name="com.and.games505.TerrariaFree" /> -->
    </queries>

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:extractNativeLibs="true"
        android:largeHeap="true"
        android:isGame="true"
        android:theme="@style/Theme.BunnyLoader">

        <!-- A Unity le estes meta-data do pacote HOSPEDEIRO (o nosso), via
             PackageManager. Copiados do manifest do Terraria para a UnityPlayer
             se comportar igual ao jogo original. -->
        <meta-data android:name="unity.splash-mode" android:value="1" />
        <meta-data android:name="unity.splash-enable" android:value="true" />
        <meta-data android:name="unity.launch-fullscreen" android:value="true" />
        <meta-data android:name="unity.auto-report-fully-drawn" android:value="true" />
        <meta-data android:name="notch.config" android:value="portrait|landscape" />

        <activity
            android:name=".LauncherActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Config espelhada da com.unity3d.player.UnityPlayerActivity do jogo
             (launchMode=singleTask, sensorLandscape, hardwareAccelerated=false,
             resizeableActivity=false). Roda em processo separado: fechar o jogo
             destrói Unity+IL2CPP+VM sem derrubar a UI do launcher. -->
        <activity
            android:name=".GameActivity"
            android:exported="false"
            android:process=":game"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:hardwareAccelerated="false"
            android:resizeableActivity="false"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|fontScale|layoutDirection|density"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
            <meta-data android:name="unityplayer.UnityActivity" android:value="true" />
            <meta-data android:name="android.notch_support" android:value="true" />
        </activity>
    </application>
</manifest>
