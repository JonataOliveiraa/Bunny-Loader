# Modelo da assinatura do APK de release. Copie para keystore.properties (que
# fica fora do Git) e preencha. O caminho do storeFile é relativo à raiz do
# projeto; use barras normais, como no local.properties.
#
# Para criar a chave (uma vez só; guarde o .jks e as senhas fora do repo):
#   keytool -genkeypair -v -keystore bunny-release.jks -alias bunny -keyalg RSA -keysize 4096 -validity 10000
storeFile=bunny-release.jks
storePassword=
keyAlias=bunny
keyPassword=
